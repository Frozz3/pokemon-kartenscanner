{
  "appId": "io.github.frozz3.kartenscanner",
  "appName": "Kartenscanner",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 3000,
      "launchFadeOutDuration": 0,
      "showSpinner": false,
      "iosSpinnerStyle": "small"
    }
  }
}
